<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The system bars are hidden (immersive) and the window is edge-to-edge, so there is no
         status bar colour to set; dark icons stay readable on the pink page when a swipe
         shows the bars for a moment. -->
    <style name="Theme.AlphabetSafari" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#FF6B8B</item>
        <item name="colorPrimaryDark">#FF4757</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/page_background</item>
    </style>

    <style name="Theme.AlphabetSafari.Fullscreen" parent="Theme.AlphabetSafari">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
